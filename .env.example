# Server-only. The chat route reads these. With neither set (and no Vercel OIDC token),
# Sidekick falls back to scripted replies and says so in the chat.

# Direct Anthropic API. Takes priority when set.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Or Vercel AI Gateway. On Vercel, the OIDC token is used automatically, but the team needs
# paid AI Gateway credits: the free tier rejects Claude models.
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_MODEL=anthropic/claude-sonnet-5.5
